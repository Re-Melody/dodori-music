<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/signin_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:windowSoftInputMode="adjustNothing|stateVisible">
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/close_button"
                    android:background="@android:color/transparent"
                    android:paddingLeft="@dimen/default_padding"
                    android:paddingRight="@dimen/default_padding"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="0x7f0800ae"
                    android:scaleType="center"
                    android:windowSoftInputMode="adjustNothing|stateVisible"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/logo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="0x7f08005d"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </FrameLayout>
        <ScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="30dp"
            android:layout_above="@+id/btn1"
            android:layout_below="@+id/signin_toolbar">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/logo_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="64dp">
                    <ImageView
                        android:id="@+id/app_logo"
                        android:layout_width="@dimen/logo_ht"
                        android:layout_height="@dimen/logo_ht"
                        android:scaleType="fitXY"
                        android:layout_centerHorizontal="true"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/arrows"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        android:src="0x7f08005e"
                        android:layout_centerHorizontal="true"/>
                    <ImageView
                        android:id="@+id/applemusiclogo"
                        android:layout_width="@dimen/logo_ht"
                        android:layout_height="@dimen/logo_ht"
                        android:src="0x7f08005c"
                        android:scaleType="fitXY"
                        android:layout_centerHorizontal="true"/>
                </LinearLayout>
                <com.apple.android.sdk.authentication.views.CustomTextView
                    android:gravity="center"
                    android:id="@+id/access_request_text1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="@string/approve_access_main"
                    android:layout_below="@+id/logo_layout"
                    style="@style/Title2"/>
                <com.apple.android.sdk.authentication.views.CustomTextView
                    android:gravity="center"
                    android:id="@+id/access_request_text2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/approve_access_sub"
                    android:layout_below="@+id/access_request_text1"
                    style="@style/Callout"/>
            </RelativeLayout>
        </ScrollView>
        <com.apple.android.sdk.authentication.views.CustomTextButton
            android:layout_gravity="bottom"
            android:id="@+id/btn1"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="50dp"
            android:text="@string/btn_install"
            android:layout_alignParentBottom="true"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            style="@style/ButtonAStyle"/>
    </RelativeLayout>
</FrameLayout>
