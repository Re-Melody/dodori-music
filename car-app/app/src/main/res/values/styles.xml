<resources>
    <!-- Graphite night-map theme; the amber accent marks the primary action only. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#F2B84B</item>
        <item name="android:colorBackground">#0E1011</item>
        <item name="android:textColorPrimary">#F2F3F1</item>
        <item name="android:textColorSecondary">#B9BDBB</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#0E1011</item>
        <item name="android:navigationBarColor">#0E1011</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#0E1011</item>
    </style>
</resources>
